<?xml version="1.0" encoding="utf-8"?>
<!--
    item_chat_message.xml
    Single row in the chat RecyclerView.
    ChatAdapter shows layoutSent (right) or layoutReceived (left) depending
    on whether the message belongs to the current user.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- ── SENT bubble — right-aligned ─────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutSent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="8dp">

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#4A6E60">

            <TextView
                android:id="@+id/tvSentMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/alata"
                android:maxWidth="260dp" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvSentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:textSize="10sp"
            android:textColor="#9BB5A7"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="4dp" />

    </LinearLayout>

    <!-- ── RECEIVED bubble — left-aligned ──────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutReceived"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="64dp">

        <!-- Optional sender name — shown for group chats; hidden 1:1 -->
        <TextView
            android:id="@+id/tvSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#9BB5A7"
            android:textStyle="bold"
            android:layout_marginBottom="2dp"
            android:layout_marginStart="4dp" />

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <TextView
                android:id="@+id/tvReceivedMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="#1B1B1B"
                android:textSize="15sp"
                android:fontFamily="@font/alata"
                android:maxWidth="260dp" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvReceivedTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:textSize="10sp"
            android:textColor="#9BB5A7"
            android:layout_marginTop="2dp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

</FrameLayout>