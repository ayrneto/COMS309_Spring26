<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- ── SENT bubble — right-aligned ─────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutSent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:layout_marginStart="72dp"
        android:layout_marginEnd="12dp">

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#2F6F5E">

            <TextView
                android:id="@+id/tvSentMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/alata"
                android:maxWidth="260dp"
                android:lineSpacingExtra="2dp" />

        </androidx.cardview.widget.CardView>

        <!-- Time + read receipt row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="4dp">

            <TextView
                android:id="@+id/tvSentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#8AAAA0" />

            <TextView
                android:id="@+id/tvReadReceipt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textSize="10sp"
                android:textColor="#9BB5A7"
                android:layout_marginStart="4dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── RECEIVED bubble — left-aligned ──────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutReceived"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="72dp">

        <TextView
            android:id="@+id/tvSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#4A6E60"
            android:textStyle="bold"
            android:layout_marginBottom="2dp"
            android:layout_marginStart="4dp" />

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF">

            <TextView
                android:id="@+id/tvReceivedMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="#1B1B1B"
                android:textSize="15sp"
                android:fontFamily="@font/alata"
                android:maxWidth="260dp"
                android:lineSpacingExtra="2dp" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvReceivedTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:textSize="10sp"
            android:textColor="#8AAAA0"
            android:layout_marginTop="3dp"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- ── SYSTEM bubble — centered ────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/layoutSystem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#E8EEE9">

            <TextView
                android:id="@+id/tvSystemMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textColor="#4A6E60"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:maxWidth="280dp"
                android:lineSpacingExtra="3dp" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</FrameLayout>