<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/offwhite_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:context=".CheckInActivity">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@drawable/light_green_background_flat"
            android:gravity="center"
            android:text="Daily Check-In"
            android:textSize="48sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/light_green_background_flat"
            android:gravity="center"
            android:text="How was your day today?"
            android:textSize="20sp" />

        <!-- Rating Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="30dp"
            android:text="Rate Your Day (1-5)"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/circle1"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="8dp"
                android:background="@drawable/circle_rating_1"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/circle2"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="8dp"
                android:background="@drawable/circle_rating_2"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/circle3"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="8dp"
                android:background="@drawable/circle_rating_3"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/circle4"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="8dp"
                android:background="@drawable/circle_rating_4"
                android:clickable="true"
                android:focusable="true" />

            <View
                android:id="@+id/circle5"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="8dp"
                android:background="@drawable/circle_rating_5"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Reminder Time -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="30dp"
            android:text="Daily Reminder Time"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/inputReminderTime"
            android:layout_width="380dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="false"
            android:hint="8:00 PM" />

        <!-- Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="30dp"
            android:text="How was your day?"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/inputDescription"
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:gravity="top"
            android:hint="Describe your day..."
            android:inputType="textMultiLine"
            android:minLines="4" />

        <!-- Buttons -->
        <Button
            android:id="@+id/btnSummary"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"
            android:text="Summary"
            android:textSize="24sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="30dp"
            android:text="Save"
            android:textSize="32sp" />

    </LinearLayout>
</ScrollView>