<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7F6">

    <!-- Top bar -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#4A6E60">

        <androidx.constraintlayout.widget.ConstraintLayout
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#FFFFFF"
                android:contentDescription="Back"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvEditTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit User"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/alata"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Full Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name"
                android:textSize="12sp"
                android:textColor="#6B6B6B"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etEditName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@color/aa_input_bg"
                android:fontFamily="@font/alata"
                android:hint="Full Name"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="16dp" />

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email"
                android:textSize="12sp"
                android:textColor="#6B6B6B"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etEditEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@color/aa_input_bg"
                android:fontFamily="@font/alata"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="16dp" />

            <!-- Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Password (leave blank to keep current)"
                android:textSize="12sp"
                android:textColor="#6B6B6B"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etEditPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@color/aa_input_bg"
                android:fontFamily="@font/alata"
                android:hint="New Password"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="16dp" />

            <!-- Confirm Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Confirm Password"
                android:textSize="12sp"
                android:textColor="#6B6B6B"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etEditConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@color/aa_input_bg"
                android:fontFamily="@font/alata"
                android:hint="Confirm Password"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="16dp" />

            <!-- Active toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/aa_input_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="28dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Account Active"
                    android:textSize="14sp"
                    android:fontFamily="@font/alata"
                    android:textColor="#1B1B1B" />

                <Switch
                    android:id="@+id/switchActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />

            </LinearLayout>

            <!-- Save user button -->
            <Button
                android:id="@+id/btnSaveUser"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Save Changes"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4A6E60"
                app:cornerRadius="26dp" />

            <!-- Counsellor fields — only shown when role is COUNSELLOR -->
            <LinearLayout
                android:id="@+id/counsellorFieldsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Counsellor Profile"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#4A6E60"
                    android:fontFamily="@font/alata"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Display Name"
                    android:textSize="12sp"
                    android:textColor="#6B6B6B"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etCDisplayName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@color/aa_input_bg"
                    android:fontFamily="@font/alata"
                    android:hint="Display Name"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Specialization"
                    android:textSize="12sp"
                    android:textColor="#6B6B6B"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etCSpecialization"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@color/aa_input_bg"
                    android:fontFamily="@font/alata"
                    android:hint="e.g. Anxiety &amp; Depression"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bio"
                    android:textSize="12sp"
                    android:textColor="#6B6B6B"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etCBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/aa_input_bg"
                    android:fontFamily="@font/alata"
                    android:hint="Bio"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:minLines="3"
                    android:gravity="top"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status"
                    android:textSize="12sp"
                    android:textColor="#6B6B6B"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spCStatus"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@color/aa_input_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="28dp" />

                <Button
                    android:id="@+id/btnSaveCounsellor"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Save Counsellor Profile"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#4A6E60"
                    app:cornerRadius="26dp" />

            </LinearLayout>

            <!-- Danger Zone -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Danger Zone"
                android:textSize="12sp"
                android:textColor="#C62828"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnDeactivate"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Deactivate Account"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#E65100"
                app:cornerRadius="26dp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnDeleteUser"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Delete Account"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#C62828"
                app:cornerRadius="26dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>