<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="180dp"
    android:layout_height="190dp"
    android:layout_margin="6dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/worryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Worry Title"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/aa_text"
            android:fontFamily="@font/alata"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/worryContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="This is a placeholder"
            android:textSize="12sp"
            android:textColor="@color/aa_muted"
            android:maxLines="4"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.3" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/aa_input_bg"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/worryDueDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Due: 2026-03-15"
            android:textSize="10sp"
            android:textColor="@color/aa_primary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/worryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Work"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/dark_green_background" />

    </LinearLayout>
</androidx.cardview.widget.CardView>