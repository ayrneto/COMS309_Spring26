<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Name + status badge row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dr. Name"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1B1B1B"
                android:fontFamily="@font/alata" />

            <!-- Status badge -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVAILABLE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="@drawable/dark_green_background" />

        </LinearLayout>

        <!-- Specialization -->
        <TextView
            android:id="@+id/tvSpecialization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Anxiety &amp; Depression"
            android:textSize="13sp"
            android:textColor="@color/aa_primary"
            android:fontFamily="@font/alata"
            android:layout_marginTop="4dp" />

        <!-- Bio -->
        <TextView
            android:id="@+id/tvBio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="#6B6B6B"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="6dp" />

        <!-- Rating row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tvRating"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="★ 0.0 (0 reviews)"
                android:textSize="13sp"
                android:textColor="#4A6E60"
                android:fontFamily="@font/alata" />

            <!-- Book button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBook"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Book"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#4A6E60"
                app:cornerRadius="18dp" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>