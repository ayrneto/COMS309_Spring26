<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Book Appointment"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1B1B1B"
        android:fontFamily="@font/alata"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvDialogCounsellorName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="@color/aa_primary"
        android:fontFamily="@font/alata"
        android:layout_marginBottom="20dp" />

    <!-- Date picker -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Date"
        android:textSize="12sp"
        android:textColor="#6B6B6B"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etDate"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/aa_input_bg"
        android:hint="Tap to pick a date"
        android:focusable="false"
        android:clickable="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:fontFamily="@font/alata"
        android:textSize="14sp"
        android:layout_marginBottom="14dp" />

    <!-- Time slot spinner -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Time Slot"
        android:textSize="12sp"
        android:textColor="#6B6B6B"
        android:layout_marginBottom="4dp" />

    <Spinner
        android:id="@+id/spinnerTimeSlot"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/aa_input_bg"
        android:padding="14dp"
        android:layout_marginBottom="14dp" />

    <!-- Notes -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notes (optional)"
        android:textSize="12sp"
        android:textColor="#6B6B6B"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/etNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/aa_input_bg"
        android:hint="Anything you'd like to mention…"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="3"
        android:gravity="top"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:fontFamily="@font/alata"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <!-- Buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelBooking"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/aa_primary"
            android:layout_marginEnd="8dp"
            app:cornerRadius="24dp"
            app:strokeColor="@color/aa_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmBooking"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Confirm"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:backgroundTint="@color/aa_primary"
            app:cornerRadius="24dp" />

    </LinearLayout>

</LinearLayout>