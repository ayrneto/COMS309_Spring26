<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── Main content ──────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/aa_input_bg">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"
            android:background="@color/aa_primary"
            android:elevation="4dp">

            <ImageButton
                android:id="@+id/btnHamburger"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="#FFFFFF"
                android:contentDescription="Open menu" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Calmify"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/alata"
                android:gravity="center" />

            <View android:layout_width="48dp" android:layout_height="48dp" />

        </LinearLayout>

        <!-- Hero banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/aa_secondary"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello,"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:alpha="0.8" />

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/alata"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How are you feeling today?"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:alpha="0.75"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Daily Quote card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✨"
                                android:textSize="14sp"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Daily Inspiration"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/aa_primary"
                                android:letterSpacing="0.08"
                                android:fontFamily="@font/alata" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDailyQuote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Loading quote..."
                            android:textSize="15sp"
                            android:textColor="@color/aa_text"
                            android:lineSpacingMultiplier="1.5"
                            android:fontFamily="@font/alata" />

                        <TextView
                            android:id="@+id/tvQuoteAuthor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="12sp"
                            android:textColor="@color/aa_muted"
                            android:layout_marginTop="8dp"
                            android:gravity="end" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Quick stats row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Tasks stat -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#FFFFFF">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="10dp">
                            <TextView
                                android:id="@+id/tvStatTasks"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/aa_primary"
                                android:fontFamily="@font/alata" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tasks left"
                                android:textSize="10sp"
                                android:textColor="@color/aa_muted" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Routines stat -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#FFFFFF">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="10dp">
                            <TextView
                                android:id="@+id/tvStatRoutines"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/aa_primary"
                                android:fontFamily="@font/alata" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Active routines"
                                android:textSize="10sp"
                                android:textColor="@color/aa_muted" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Check-in stat -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#FFFFFF">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="10dp">
                            <TextView
                                android:id="@+id/tvStatCheckIn"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="@color/aa_primary"
                                android:fontFamily="@font/alata" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Today's mood"
                                android:textSize="10sp"
                                android:textColor="@color/aa_muted" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- Section header: Today's Summary -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's Summary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/aa_text"
                    android:fontFamily="@font/alata"
                    android:layout_marginBottom="10dp" />

                <!-- Dynamic dashboard cards injected here by HomeActivity.loadDashboard() -->
                <LinearLayout
                    android:id="@+id/dashboardContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!-- ── Navigation Drawer ──────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <!-- Drawer header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:orientation="vertical"
            android:gravity="bottom"
            android:padding="20dp"
            android:background="@color/aa_primary">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="N"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/dark_green_background"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/drawerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello!"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/alata" />

            <TextView
                android:id="@+id/drawerEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#C2E8DA"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/aa_input_bg" />

        <!-- Menu items -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <LinearLayout android:id="@+id/drawerItemFindCounsellor" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="🔍" android:textSize="15sp" android:layout_marginEnd="12dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Find a Counselor" android:textSize="14sp" android:textColor="@color/aa_text" android:fontFamily="@font/alata" />
            </LinearLayout>

            <LinearLayout android:id="@+id/drawerItemWorryNotes" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="📝" android:textSize="15sp" android:layout_marginEnd="12dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Worry Notes" android:textSize="14sp" android:textColor="@color/aa_text" android:fontFamily="@font/alata" />
            </LinearLayout>

            <LinearLayout android:id="@+id/drawerItemChat" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="💬" android:textSize="15sp" android:layout_marginEnd="12dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="My Counselors" android:textSize="14sp" android:textColor="@color/aa_text" android:fontFamily="@font/alata" />
            </LinearLayout>

            <LinearLayout android:id="@+id/drawerItemAiChat" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:visibility="gone">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="🧠" android:textSize="15sp" android:layout_marginEnd="12dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI Assistant" android:textSize="14sp" android:textColor="@color/aa_text" android:fontFamily="@font/alata" />
            </LinearLayout>

            <LinearLayout android:id="@+id/drawerItemMyTasks" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:visibility="gone">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="✅" android:textSize="15sp" android:layout_marginEnd="12dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="My Tasks" android:textSize="14sp" android:textColor="@color/aa_text" android:fontFamily="@font/alata" />
            </LinearLayout>

            <LinearLayout android:id="@+id/drawerItemAssignTask" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:visibility="gone">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="📋" android:textSize="15sp" android:layout_marginEnd="12dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Assign Task" android:textSize="14sp" android:textColor="@color/aa_text" android:fontFamily="@font/alata" />
            </LinearLayout>

            <LinearLayout android:id="@+id/drawerItemCheckIn" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:visibility="gone">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="📊" android:textSize="15sp" android:layout_marginEnd="12dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Check-In" android:textSize="14sp" android:textColor="@color/aa_text" android:fontFamily="@font/alata" />
            </LinearLayout>

            <LinearLayout android:id="@+id/drawerRoutineTracker" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:visibility="gone">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="🔄" android:textSize="15sp" android:layout_marginEnd="12dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Routine Tracker" android:textSize="14sp" android:textColor="@color/aa_text" android:fontFamily="@font/alata" />
            </LinearLayout>

            <LinearLayout android:id="@+id/drawerItemPrescriptions" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" android:visibility="gone">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="💊" android:textSize="15sp" android:layout_marginEnd="12dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Prescriptions" android:textSize="14sp" android:textColor="@color/aa_text" android:fontFamily="@font/alata" />
            </LinearLayout>

            <LinearLayout android:id="@+id/drawerItemEditProfile" android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="👤" android:textSize="15sp" android:layout_marginEnd="12dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Edit Profile" android:textSize="14sp" android:textColor="@color/aa_text" android:fontFamily="@font/alata" />
            </LinearLayout>

        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/aa_input_bg" />

        <LinearLayout android:id="@+id/drawerItemLogout" android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
            <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="↩" android:textSize="15sp" android:layout_marginEnd="12dp" android:textColor="#C0392B" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Log Out" android:textSize="14sp" android:textStyle="bold" android:textColor="#C0392B" android:fontFamily="@font/alata" />
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>