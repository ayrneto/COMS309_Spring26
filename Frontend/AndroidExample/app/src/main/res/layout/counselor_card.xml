<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Avatar initial -->
        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="?"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:fontFamily="@font/alata"
            android:background="@drawable/dark_green_background"
            android:layout_marginEnd="14dp" />

        <!-- Name + email -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/counselorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dr. Smith"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/aa_text"
                android:fontFamily="@font/alata" />

            <TextView
                android:id="@+id/counselorEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="smith@example.com"
                android:textSize="12sp"
                android:textColor="@color/aa_muted"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Chevron -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="22sp"
            android:textColor="@color/aa_secondary" />

    </LinearLayout>
</androidx.cardview.widget.CardView>