<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/offwhite_background"
    android:orientation="vertical"
    tools:context=".AssignTaskActivity"
    >

    <TextView
        android:layout_marginTop="0dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:background="@drawable/light_green_background_flat"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:text="Task Assignment"
        android:textSize="48sp"
        />

    <TextView
        android:layout_marginTop="0dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:background="@drawable/light_green_background_flat"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Assign a task for a user to complete"
        android:textSize="20sp"
        />

    <TextView
        android:layout_marginTop="20dp"
        android:layout_marginStart="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User's Email"
        android:textSize="20sp"
        />

    <EditText
        android:id="@+id/taskEmail"
        android:layout_marginStart="10dp"
        android:layout_gravity="left"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:hint="email@example.com"
        android:layout_marginBottom="20dp" />

</LinearLayout>