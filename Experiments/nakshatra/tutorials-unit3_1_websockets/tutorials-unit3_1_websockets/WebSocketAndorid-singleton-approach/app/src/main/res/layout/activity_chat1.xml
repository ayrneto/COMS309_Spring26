<?xml version="1.0" encoding="utf-8"?>
<!--
    MODIFICATIONS by Nakshatra Gupta:
    - Added message counter TextView at the top
    - Changed Send button color to teal
    - Changed Back button color to deep purple
    - Changed chat background color to light blue-gray
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ChatActivity1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F0F4F8">

    <!-- Message Counter -->
    <TextView
        android:id="@+id/counterTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Messages received: 0"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:background="#37474F"
        android:padding="8dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Chat Display Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/counterTv"
        app:layout_constraintBottom_toTopOf="@id/messageLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tx1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The Conversation will appear here:"
                android:textSize="16sp"
                android:padding="12dp"
                android:background="#546E7A"
                android:textColor="@android:color/white"
                android:gravity="center" />
        </LinearLayout>

    </ScrollView>

    <!-- Input Area -->
    <LinearLayout
        android:id="@+id/messageLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@android:color/white"
        app:layout_constraintBottom_toTopOf="@id/backMainBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/msgEdt"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:hint="Type a message..."
            android:textSize="16sp"
            android:background="@android:color/white"
            android:padding="12dp"
            android:layout_marginEnd="8dp"
            android:elevation="4dp" />

        <!-- Send button - teal color -->
        <Button
            android:id="@+id/sendBtn"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="Send"
            android:padding="12dp"
            android:backgroundTint="#00897B"
            android:textColor="@android:color/white"/>
    </LinearLayout>

    <!-- Back Button - deep purple -->
    <Button
        android:id="@+id/backMainBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back to Main"
        android:layout_marginTop="16dp"
        android:backgroundTint="#4527A0"
        android:textColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>